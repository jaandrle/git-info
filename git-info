#!/usr/bin/env bash
# git-info — Jan Andrle
## Theme Configuration
declare COLOR_ACCENT='\033[34m'      # Blue
declare COLOR_SECTION='\033[32m'     # Green
declare COLOR_SECTION_ALT='\033[36m' # Cyan
declare COLOR_STRONG='\033[1m'       # Bold
declare COLOR_OK='\033[32m'          # Green
declare COLOR_WARN='\033[33m'        # Orange
declare COLOR_KO='\033[31m'          # Red
declare COLOR_NOTE='\033[37;2m'      # GRAY

readonly SEP='┊'

## Internal Constants
readonly VERSION="1.4.0"
declare COLOR_RESET='\033[0m'
declare COLOR_DIM='\033[2m'

## Body (`main` function call)
get_defaultBranch() { # Detects the default branch from remote
	local default_branch=''
	local remote='origin'
	
	# Method 1: Check local config for default branch (fast, no network)
	default_branch=$(git config "remote.$remote.branch.default" 2>/dev/null || true)
	if [[ -n "$default_branch" ]]; then
		echo "$remote/$default_branch"
		return
	fi
	
	# Method 2: Try to get from git symbolic-ref (very fast)
	local head_ref
	head_ref=$(git symbolic-ref "refs/remotes/$remote/HEAD" 2>/dev/null || true)
	if [[ -n "$head_ref" ]]; then
		echo "${head_ref#refs/remotes/}"
		return
	fi
	
	# Method 3: Fallback to common default branches
	local common_branches=("main" "master" "develop" "trunk")
	for branch in "${common_branches[@]}"; do
		if git show-ref --verify --quiet "refs/remotes/$remote/$branch" 2>/dev/null; then
			echo "$remote/$branch"
			return
		fi
	done
	
	# Method 4: Ultimate fallback
	echo "$remote/main"
}
is_gitRepo() {
	git rev-parse --show-toplevel > /dev/null 2>&1;
	local -r result=$?
	if [[ $result != 0 ]]; then
		>&2 echo 'Not a git repository'
		exit $result
	fi
}
component_usage() {
	local usage
	read -r -d '' usage <<-'USAGE'
		Git status inspired by GitButler CLI.
		
		Usage:
		  git-info [options]
		  git-info help        Show this help message
		
		Description:
		  A colorful and informative Git status tool that displays unstaged changes,
		  staged changes, commit history, and branch information.
		
		Options:
		  -f                Show files for each commit in history
		  -h, --help        Show this help message
		  --version         Show version information
		
		UI Elements:
		  ╭┄ [section]     Section headers (branch/staged/unstaged)
		  ●                Commit on remote (green)
		  ◐                Commit not on remote yet
		  ! operation      In-progress Git operation
		  M/A/D            File status (Modified/Added/Deleted)
		  ┴ hash [branch]  Footer with target branch info
		  Hint:            Contextual hint
	USAGE
	echo "$usage"
}
process_cliStart() {
	local -n _show_files=$1
	shift

	local colors=true

	# Colors only when stdout is a terminal.
	if [[ ! -t 1 ]]; then
		colors=false
	fi

	while (($#)); do
		case "$1" in
			-f)
				_show_files=true
				;;

			-c|--color|--colors)
				colors=true
				;;

			-fc|-cf)
				_show_files=true
				colors=true
				;;

			-v|--version)
				echo "$VERSION"
				exit 0
				;;

			-h|--help|help)
				component_usage
				exit 0
				;;

			--)
				shift
				break
				;;

			-*)
				echo "Invalid option: $1." >&2
				echo "Try '$0 --help' for usage." >&2
				exit 1
				;;

			*)
				echo "Unexpected argument: $1." >&2
				echo "Try '$0 --help' for usage." >&2
				exit 1
				;;
		esac

		shift
	done

	# Reject positional arguments unless you intend to support them.
	if (($#)); then
		echo "Unexpected argument: $1." >&2
		echo "Try '$0 --help' for usage." >&2
		exit 1
	fi

	is_gitRepo

	if [[ "$colors" == false ]]; then
		COLOR_ACCENT=''
		COLOR_SECTION=''
		COLOR_SECTION_ALT=''
		COLOR_STRONG=''
		COLOR_OK=''
		COLOR_WARN=''
		COLOR_KO=''
		COLOR_NOTE=''
		COLOR_RESET=''
		COLOR_DIM=''
	fi
}
fetch_numstat() {
	# shellcheck disable=SC2178
	local -n out=$1
	out=()
	local line
	while IFS= read -r line || [[ -n "$line" ]]; do
		local additions='' deletions='' file=''
		read -r additions deletions file <<< "$line"
		[[ -z "$file" ]] && continue
		# shellcheck disable=SC2034
		out["$file"]="${additions}+${deletions}-"
	done < <(git diff --numstat 2>/dev/null)
	# new files
	while IFS= read -r line || [[ -n "$line" ]]; do
		local file=''
		read -r file <<< "$line"
		[[ -z "$file" ]] && continue
		# shellcheck disable=SC2034
		out["$file"]=""
	done < <(git ls-files --others --exclude-standard 2>/dev/null)
}
fetch_staged() {
	# shellcheck disable=SC2178
	local -n out=$1
	out=()
	local stat file
	while IFS=$'\t' read -r stat file || [[ -n "$stat" ]]; do
		[[ -z "$file" ]] && continue
		# shellcheck disable=SC2034
		out["$file"]="$stat"
	done < <(git diff --cached --name-status 2>/dev/null)
}
cache_files() {
	local -n __numstat_cache=$1;      fetch_numstat "$1"
	local -n __staged_files_cache=$2; fetch_staged "$2"
	local -n _has_unstaged=$3
	local -n _has_staged=$4
	(( ${#__numstat_cache[@]} > 0 ))      && _has_unstaged=true
	(( ${#__staged_files_cache[@]} > 0 )) && _has_staged=true
}
fmt_hash() { # formats a 7-char hash with first 4 chars in accent color, last 3 dimmed 
	local -r hash="$1"
	echo -ne "${COLOR_ACCENT}${hash:0:4}${COLOR_DIM}${hash:4:3}${COLOR_RESET}"
}
fmt_hashes() { # formats multiple hashes separated by space
	local -r hashes="$1"
	local result=''
	local IFS=','
	for hash in $hashes; do
		if [[ -n "$result" ]]; then
			result="$result "
		fi
		result="$result$(fmt_hash "$hash")"
	done
	echo -ne "$result"
}
fmt_label() {
	local -r mode="${1:-accent}" # accent, normal
	local -r label="${2:-}"
	local color="${COLOR_SECTION}"
	if [[ "$mode" == 'normal' ]]; then
		color="${COLOR_SECTION_ALT}"
	fi
	printf "[${COLOR_STRONG}${color}%s${COLOR_RESET}]" \
		"$label"
}
fmt_auth() {
	local -r user="$1"
	local -r relative="$2"
	printf "$COLOR_NOTE(%s · %s)${COLOR_RESET}" \
		"$user" "$relative"
}
component_branchRoot(){
	local TARGET_HASH=$1
	local TARGET_REF=$2
	if [[ -z "$TARGET_HASH" ]]; then
		TARGET_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo '')
		TARGET_REF='unknown'
	fi
	
	local line
	if [[ -z "$TARGET_HASH" ]]; then
		TARGET_REF='unknown remote'
		line="$(fmt_label accent "$TARGET_REF")"
	else
		local TARGET_DATE=''
		local TARGET_MSG=''
		local TARGET_AUTHOR=''
		# Fetch target commit info in one call if not already cached
		if [[ -z "$TARGET_DATE" || -z "$TARGET_MSG" ]]; then
			local target_info
			target_info=$(git show -s --format='%ar|%an|%s' "$TARGET_HASH" 2>/dev/null || echo '')
			IFS='|' read -r TARGET_DATE TARGET_AUTHOR TARGET_MSG <<< "$target_info"
		fi
		
		line="$(fmt_hash "$TARGET_HASH") $(fmt_label accent "$TARGET_REF") ${TARGET_MSG} $(fmt_auth "$TARGET_AUTHOR" "$TARGET_DATE")"
	fi
	echo -e "├╯"
	echo -e "┴ $line"
}
echo_file_entry() { # Prints a file entry with consistent formatting
	local status="$1"
	local file="$2"
	local context="$3" # unstaged, staged, or stashed
	local hash="${4:-}"    # Optional: last commit hash (or multiple hashes)
	local numstat="${5:-}" # Optional: numstat string
	
	local color=''
	local status_char=''
	local hash_display=''
	
	status_char="${status:0:1}"
	
	case "$status_char" in
		'M') color="${COLOR_WARN}" ;;
		'D') color="${COLOR_KO}"    ;;
		'U') color="${COLOR_KO}"    ;;
		'A') color="${COLOR_OK}"    ;;
		*)   color="${COLOR_ACCENT}" ;;
	esac
	
	if [[ -n "$hash" ]]; then
		if [[ "$hash" == *','* ]]; then
			hash_display="$(fmt_hashes "$hash")"
		else
			hash_display="$(fmt_hash "$hash")"
		fi
	elif [[ "$status_char" == 'A' ]]; then
		hash_display="${COLOR_NOTE}new file${COLOR_RESET}"
	fi
	if [[ '' != "$hash_display" ]]; then
		hash_display="…${COLOR_RESET} ${hash_display}"
	else
		hash_display="${COLOR_RESET}"
	fi
	
	if [[ "$context" == 'staged' || "$context" == 'commit' ]]; then
		printf "${SEP}│   %s ${color}%s${COLOR_RESET}\n" \
			"$status_char" "$file"
	else
		printf "${SEP}    %s ${color}%s${COLOR_RESET} ${COLOR_NOTE}%s %b\n" \
			"$status_char" "$file" "$numstat" "$hash_display"
	fi
}
echo_header() { # branch/section headers
	local type="$1"
	local label="$2"
	case "$type" in
		'unstaged') echo -e "╭┄┄ $(fmt_label normal "$label")" ;;
		'staged') echo -e "${SEP}╭┄┄ $(fmt_label normal "$label")" ;;
		'branch')   echo -e "${SEP}╭┄ $(fmt_label accent "$label")" ;;
		'stacked')  echo -e "${SEP}├┄ $(fmt_label accent "$label")" ;;
	esac
}
echo_remote_status() { # Checks remote status for the commit dot 
	local -r status="${1:-}" # 1 = on remote, 0 = not on remote
	if [[ "$status" == '1' ]]; then
		echo -e "${COLOR_OK}●${COLOR_RESET}"
	else
		echo -e "${COLOR_RESET}◐${COLOR_RESET}"
	fi
}
component_branches() {
	local -r DEFAULT_BRANCH=$1
	local -r show_files=$2
	local -r staged_files_count=$3
	local -n _target_hash=$4
	local -n _target_ref=$5
	# Dynamic Commit Groups
	local current_group
	current_group=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')
	if [[ "$staged_files_count" -gt 0 ]]; then
		echo_header 'stacked' "$current_group"
	else
		echo_header 'branch' "$current_group"
	fi
	
	# Pre-compute set of commits reachable from any remote branch (O(1) lookup)
	local -A on_remote_set
	while read -r h; do
		on_remote_set["$h"]=1
	done < <(git rev-list --remotes --abbrev-commit --abbrev=7 2>/dev/null)
	
	local HASH REFS MSG AUTHT AUTHU
	while IFS='|' read -r HASH REFS MSG AUTHT AUTHU; do
		if [[ -z "$HASH" ]]; then # ?no log history ⇒ no commits
			continue
		fi
		if [[ -n "$REFS" ]]; then # Clean refs: remove HEAD pointers and tag prefixes using bash string replacement
			local CLEAN_REFS
			CLEAN_REFS="${REFS//HEAD -> /}"
			CLEAN_REFS="${CLEAN_REFS//tag: /}"

			# Check if we hit the target/upstream branch
			if [[ "$CLEAN_REFS" == *"$DEFAULT_BRANCH"* ]]; then
				_target_hash="$HASH"
				# Extract target ref
				IFS=',' read -ra REFS_ARRAY <<< "$CLEAN_REFS"
				for ref in "${REFS_ARRAY[@]}"; do
					ref="${ref#"${ref%%[![:space:]]*}"}"  # trim leading whitespace
					if [[ "$ref" == "$DEFAULT_BRANCH" ]]; then
						_target_ref="$ref"
						break 2
					fi
				done
			fi

			# Detect a new local branch label (Stacked branches) using bash array
			local NEW_GROUP=''
			IFS=',' read -ra REFS_ARRAY <<< "$CLEAN_REFS"
			for ref in "${REFS_ARRAY[@]}"; do
				ref="${ref#"${ref%%[![:space:]]*}"}"  # trim leading whitespace
				if [[ "$ref" != *"origin/"* && "$ref" != *"gitbutler/"* && "$ref" != "$current_group" ]]; then
					NEW_GROUP="$ref"
					break
				fi
				done
			if [[ -n "$NEW_GROUP" && "$NEW_GROUP" != "$current_group" ]]; then
				current_group="$NEW_GROUP"
				echo -e "${SEP}│"
				echo_header 'stacked' "$current_group"
			fi
		fi

		local DOT
		DOT=$(echo_remote_status "${on_remote_set[$HASH]:-0}")
		echo -e "${SEP}$DOT   $(fmt_hash "$HASH") $MSG $(fmt_auth "$AUTHU" "$AUTHT")"
		
		# Show commit files if -f flag is provided
		if [[ "$show_files" == true ]]; then
			while IFS= read -r line; do
				if [[ -n "$line" ]]; then
					local STAT
					local FILE
					
					STAT="${line:0:1}"
					FILE="${line:2}"
					
					[[ -z "$FILE" ]] && continue
					
					# Use echo_file_entry function with commit context
					echo_file_entry "$STAT" "$FILE" 'commit'
				fi
			done < <(git show --name-status --format='' "$HASH" 2>/dev/null || echo '')
		fi
	done < <(git log --format='%h|%D|%s|%ar|%an' HEAD 2>/dev/null || echo '')
}
get_inProgress() { # Detects rebase/merge/cherry-pick/revert in progress and outputs operation type
	local state_dir=''
	local operation=''

	if [[ -d .git/rebase-merge ]]; then
		state_dir='.git/rebase-merge'
		if [[ -f "$state_dir/interactive" ]]; then
			operation='rebase'
		else
			operation='rebase'
		fi
	elif [[ -d .git/rebase-apply ]]; then
		operation='rebase'
	elif [[ -f .git/MERGE_HEAD ]]; then
		operation='merge'
	elif [[ -f .git/CHERRY_PICK_HEAD ]]; then
		operation='cherry-pick'
	elif [[ -f .git/REVERT_HEAD ]]; then
		operation='revert'
	fi

	echo "$operation"
}
component_hint() {
	local -r has_staged="$1"
	local -r has_unstaged="$2"
	local -r TARGET_HASH="$3"
	local HINT=''
	local IN_PROGRESS_OP
	IN_PROGRESS_OP=$(get_inProgress)
	if [[ -n "$IN_PROGRESS_OP" ]]; then
		# shellcheck disable=SC2016
		case "$IN_PROGRESS_OP" in
			'rebase')      HINT='resolve conflicts, `git add`, then `git rebase --continue`' ;;
			'merge')       HINT='resolve conflicts, `git add`, then `git commit`' ;;
			'cherry-pick') HINT='resolve conflicts, `git add`, then `git cherry-pick --continue`' ;;
			'revert')      HINT='resolve conflicts, `git add`, then `git revert --continue`' ;;
		esac
	else
		# shellcheck disable=SC2016
		if $has_staged; then
			HINT='run `git commit` to commit staged changes'
		elif $has_unstaged; then
			HINT='run `git diff` to see changes, `git add` to stage'
		elif [[ -z "$TARGET_HASH" ]]; then # ≡ no commits, no remote
			HINT='run `git add` to stage files (you may also need to set a remote: `git remote add origin <url>`)'
		fi
	fi
	if [[ -n "$HINT" ]]; then
		echo -e "\n${COLOR_NOTE}Hint: ${HINT}${COLOR_RESET}"
	fi
}

component_inProgress() { # Renders rebase/merge/cherry-pick/revert in progress
	local operation=''
	local step=''
	local total=''

	operation=$(get_inProgress)

	if [[ -z "$operation" ]]; then
		return 0
	fi

	# Get step/total for rebase operations
	if [[ -d .git/rebase-merge ]]; then
		step=$(cat .git/rebase-merge/msgnum 2>/dev/null || echo '1')
		total=$(cat .git/rebase-merge/end 2>/dev/null || echo '?')
		# Override operation to show "rebase -i" for interactive
		if [[ -f .git/rebase-merge/interactive ]]; then
			operation='rebase -i'
		fi
	elif [[ -d .git/rebase-apply ]]; then
		step=$(cat .git/rebase-apply/next 2>/dev/null || echo '1')
		total=$(cat .git/rebase-apply/last 2>/dev/null || echo '?')
	fi

	local color="${COLOR_WARN}"
	if [[ "$operation" == 'merge' ]]; then
		color="${COLOR_ACCENT}"
	fi
	if [[ -n "$step" && -n "$total" && "$total" != "?" ]]; then
		echo -e "${color}! $operation ($step/$total)${COLOR_RESET}"
	else
		echo -e "${color}! $operation${COLOR_RESET}"
	fi
	echo
}
component_staged(){
	local -r has_staged="$1"
	if [[ $has_staged == false ]]; then
		return
	fi
	local -n __staged_files_cache=$2
	echo_header 'staged' 'staged changes'
	while IFS= read -r file; do
		local STAT="${__staged_files_cache[$file]:0:1}"
		echo_file_entry "$STAT" "$file" 'staged'
	done < <(printf '%s\n' "${!__staged_files_cache[@]}" | sort)
	echo -e "${SEP}│"
}
join_lines() {
	local first=1 line
	while IFS= read -r line; do
		if (( first )); then
			first=0
		else
			printf ','
		fi
		printf '%s' "$line"
	done
}

_format_numstat() {
	local added deleted
	read -r added deleted _ || return
	printf '%s+%s-' "$added" "$deleted"
}
component_stashed() {
	local -r _default_branch="$1"
	local stashed_entries
	stashed_entries=$(git stash list --format='%gd:%gs' 2>/dev/null || echo '')
	if [[ -z "$stashed_entries" ]]; then
		return
	fi
	local stash_index stash_branch stash_message count=0
	while IFS=':' read -r stash_index stash_branch stash_message; do
		# On branch → branch
		stash_branch="${stash_branch/On /}"
		stash_message="${stash_message#"${stash_message%%[![:space:]]*}"}"
		if [[ -n "$stash_index" ]]; then
			if (( count++ == 0 )); then
				echo -e "${SEP}"
			fi
			# Create section header for each stash with formatted index
			printf "├┄┄ [${COLOR_STRONG}${COLOR_SECTION}%s${COLOR_RESET} ${COLOR_SECTION_ALT}%s${COLOR_RESET}] %s\n" \
				"$stash_branch" "$stash_index" "$stash_message"
			
				# Show stash files if available - similar to unstaged/staged format
				local stash_files
				stash_files=$(git stash show --include-untracked --name-status "$stash_index" 2>/dev/null)
				if [[ -n "$stash_files" ]]; then
					local line
					while IFS= read -r line; do
						if [[ -n "$line" ]]; then
							local STAT
							local FILE
							local LAST_HASH
							local NUMSTAT
							
							STAT="${line:0:1}"
							FILE="${line:2}"
							
							[[ -z "$FILE" ]] && continue
							
							if [[ "$STAT" == 'A' ]]; then
								LAST_HASH=''
								NUMSTAT=''
							else
								# Fetch and format the last hash to touch this file 
								local RAW_HASHES
								RAW_HASHES=$(git log --format='%h' "$_default_branch".."$stash_index" -- "$FILE" 2>/dev/null | join_lines)
								LAST_HASH="$RAW_HASHES"
								# Get numstat for this file
								NUMSTAT=$(git diff --numstat "$stash_index^..$stash_index" -- "$FILE" 2>/dev/null | _format_numstat || echo '')
							fi
							
							echo_file_entry "$STAT" "$FILE" 'stashed' "$LAST_HASH" "$NUMSTAT"
						fi
						done <<< "$stash_files"
				fi
		fi
	done <<< "$stashed_entries"
}
component_unstaged() {
	echo_header 'unstaged' 'unstaged changes'
	local -r _has_unstaged="$1"
	if [[ $_has_unstaged == false ]]; then
		local COLOR_EMPHASIS="\e[3m"
		echo -e "${SEP}    ${COLOR_EMPHASIS}no changes${COLOR_RESET}"
	fi
	local -r _default_branch="$2"
	local -n __numstat_cache="$3"
	local line
	git status --short --no-branch 2>/dev/null | while IFS= read -r line; do
		local STAT="${line:0:2}"
		local FILE="${line:3}"

		[[ -z "$FILE" ]] && continue
		[[ "${STAT:1:1}" == " " ]] && continue

		local LAST_HASH NUMSTAT
		local UNSTAGED_STAT="${STAT:1:1}"
		if [[ "$STAT" == '?' || "$STAT" == 'A' || "$UNSTAGED_STAT" == '?' || "$UNSTAGED_STAT" == 'A' ]]; then
			LAST_HASH=''
			UNSTAGED_STAT='A'
		else
			LAST_HASH=$(git log --format='%h' "$_default_branch"..HEAD -- "$FILE" 2>/dev/null | join_lines)
		fi
		NUMSTAT=${__numstat_cache["$FILE"]:-}

		echo_file_entry "$UNSTAGED_STAT" "$FILE" 'unstaged' "$LAST_HASH" "$NUMSTAT"
	done
	echo -e "$SEP"
}

main() {
	local show_files=false
	process_cliStart show_files "$@"
	local -r DEFAULT_BRANCH=$(get_defaultBranch)
	local -A _numstat_cache _staged_files_cache
	local has_unstaged=false has_staged=false
	cache_files _numstat_cache _staged_files_cache has_unstaged has_staged
	
	component_inProgress
	component_unstaged "$has_unstaged" "$DEFAULT_BRANCH" _numstat_cache
	component_stashed "$DEFAULT_BRANCH"
	component_staged "$has_staged" _staged_files_cache
	local TARGET_HASH='' TARGET_REF=''
	component_branches \
		"$DEFAULT_BRANCH" "$show_files" "${#_staged_files_cache[@]}" \
		TARGET_HASH TARGET_REF # sideeffect
	component_branchRoot "$TARGET_HASH" "$TARGET_REF"
	component_hint "$has_staged" "$has_unstaged" "$TARGET_HASH"
}
main "$@"
